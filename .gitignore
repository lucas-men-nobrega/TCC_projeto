# Ignorar todos os arquivos CSV (evita subir os 5 GB)
*.csv
**/*.csv
base/*.csv

# Ignorar caches do Python e ambientes virtuais
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.ipynb_checkpoints/

# Ignorar arquivos do sistema operacional
Thumbs.db
Desktop.ini
.DS_Store

# Cache agregado gerado pelo painel (dashboard/server.py)
dashboard/cache/
# Pasta do container montada por deploy/publicar.py
deploy/app/
# Modelos treinados (gerados por comparar_modelos_ml.py; podem ter centenas de MB)
modelagem/resultados/modelos/
# Logs automáticos de treino do CatBoost (gerados ao rodar os scripts a partir de modelagem/)
modelagem/catboost_info/
